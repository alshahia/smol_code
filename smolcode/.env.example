# smolcode — environment variable template.
# Copy to .env and fill in only the providers you actually use.
# NEVER commit a populated .env.
#
# Precedence (highest first): CLI flag > shell env > .env > dataclass default.
# Only the FIRST existing .env is loaded, from:
#   ./.env, <repo>/smolcode/.env, <repo>/.env, $HOME/.env
# (see DEFAULT_DOTENV_SEARCH_PATHS in src/smolcode/config.py).
# Shell exports always win over the file (python-dotenv override=False).
#
# Decision 0044 §6: this file lists the variables the code actually reads.
# Test-only switches (SMOLCODE_ALLOW_ANY, SMOLCODE_BYPASS_TIER,
# SMOLCODE_RESTRICTED_*, SMOLCODE_TEST_*) are deliberately NOT documented
# here; SMOLCODE_TIER is NOT honoured at all (tier is chosen by --tier).

# ---- Provider keys -------------------------------------------------------
# The provider is selected with SMOLCODE_PROVIDER / --provider. Only the key
# for the provider you use needs a value. Keys travel to the host-side model
# client; they are never placed in the sandbox container environment.

# Default provider (opencode-go). If the existing key has been exposed, see
# docs/decisions/0015-m12-spa-ux-polish-cli-parity.md §11 — Key rotation
# procedure — and regenerate it before pasting below.
OPENCODE_GO_APIKEY=
OPENCODE_HOST=https://opencode.ai/zen/go/v1

# Secondary first-class provider (MiniMax).
MINIMAX_API_KEY=
MINIMAX_HOST=https://api.minimax.io/v1

# LiteLLM-native providers (off unless SMOLCODE_PROVIDER selects them).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Custom OpenAI-compatible endpoint (SMOLCODE_PROVIDER=custom).
CUSTOM_BASE_URL=
CUSTOM_API_KEY=

# ---- LiteLLM proxy (M6; optional; leave empty for direct provider access) -
# When set, `LiteLLMModel(api_base=...)` is used instead of talking to the
# upstream provider directly. The proxy is shipped in
# docker-compose.litellm.yml + litellm_config.yaml; start with
# `docker compose -f docker-compose.litellm.yml up -d`. See
# docs/litellm-proxy.md for the full usage guide and
# docs/decisions/0002-litellm-proxy.md for the design.
SMOLCODE_LITELLM_PROXY=

# ---- Core runtime --------------------------------------------------------
# docker (default, sandboxed) or local (development only, NOT a sandbox).
SMOLCODE_EXECUTOR=docker
# opencode-go | MiniMax | openai | anthropic | custom  (case-sensitive).
SMOLCODE_PROVIDER=opencode-go
# Catalog default is "deepseek-v4-flash"; `smolcode models help` lists the
# catalog verbs (there is no --list-models flag).
SMOLCODE_MODEL=deepseek-v4-flash
# Default: <repo>/workspace/. Created on first run if missing.
SMOLCODE_WORKSPACE=
# SPA project switcher: "name1,name2" (roots under the workspace) or
# "name1=path1,name2=path2" (relative paths resolve against the workspace;
# absolute paths must already exist). Empty = single implicit project.
SMOLCODE_PROJECTS=
# DEBUG | INFO | WARNING | ERROR | CRITICAL (default INFO).
SMOLCODE_LOG_LEVEL=INFO

# ---- User uploads (M8, decision 0010 D8) ---------------------------------
# Default: <workspace>/.smolcode/uploads/
SMOLCODE_UPLOAD_DIR=
# Per-file cap in bytes (default 52428800 = 50 MB); must be > 0.
SMOLCODE_UPLOAD_MAX_BYTES=
# Comma-separated MIME prefixes ("text/") or exact types; empty = built-in
# list (text/*, JSON/XML/YAML, PDF/DOC/DOCX/XLS/XLSX, PNG/JPEG/GIF/WebP).
SMOLCODE_UPLOAD_ALLOWED_MIME=

# ---- Audit log (M13/M14, decisions 0016 + 0018) --------------------------
# Default: <cwd>/logs/audit.jsonl — relative to where you launch smolcode.
SMOLCODE_AUDIT_LOG=
# Hash chain is ON by default. Set to 0 to disable it (not recommended:
# `smolcode audit verify` can no longer detect tampering).
SMOLCODE_AUDIT_HASH_CHAIN=

# ---- Cost accounting / caps (decisions 0025 Q5 + 0032) -------------------
# JSON: {"provider": {"model": [input_per_1k, output_per_1k, cache_per_1k]}}
# Empty = built-in catalog rates.
SMOLCODE_COST_RATES=
# JSON: {"provider": daily_usd_cap}. Empty = NO ceiling; smolcode logs one
# WARNING at startup to say so.
SMOLCODE_COST_CAPS=

# ---- MCP servers ---------------------------------------------------------
# Path to mcp_config.json (or --mcp-config). Empty = no MCP tools.
SMOLCODE_MCP_CONFIG=
# MCP tools execute on the HOST, outside the container. Under
# SMOLCODE_EXECUTOR=docker they are refused unless this is truthy
# (1/true/yes/on). Set it only if you accept that.
SMOLCODE_ALLOW_UNSANDBOXED_MCP=

# ---- Approval gates ------------------------------------------------------
# Skip the destructive-operation prompt. Truthy values: 1/true/yes/on.
# Known limitation (A3, ADR 0041): under the docker executor the bound policy
# is decided when the toolset is built, so this does NOT authorise a
# destructive command running inside the sandbox — it fails closed there.
SMOLCODE_AUTO_APPROVE_DESTRUCTIVE=
# Seconds to wait for the full-access y/N prompt (default 30).
SMOLCODE_FULL_ACCESS_CONFIRM_TIMEOUT_S=
# Seconds to wait for a destructive-op approval (default 30).
SMOLCODE_DESTRUCTIVE_CONFIRM_TIMEOUT_S=

# ---- Web GUI (smolcode web) ----------------------------------------------
# There are no host/port env vars: pass `--host`/`--port` (defaults
# 127.0.0.1:7860). Only loopback binds are accepted.
# Whole-run wall clock for web-started runs, seconds (default 900).
SMOLCODE_WEB_RUN_TIMEOUT_S=
# Grace period to drain an SSE subscriber after a run ends (default 30).
SMOLCODE_WEB_RUN_DRAIN_S=
# Max bytes of @-mention context injected per request (default 32768).
SMOLCODE_WEB_MENTION_MAX_BYTES=
# Inline diff gate: 1 = on (default), 0 = off.
SMOLCODE_WEB_DIFF_GATE=
