# smolcode — environment variable template.
# Copy to .env and fill in only the providers you actually use.
# NEVER commit a populated .env.

# ---- Default provider (opencode-go) --------------------------------------
# Get your key from the opencode-go dashboard; if the existing key has
# been exposed (see docs/decisions/0015-m12-spa-ux-polish-cli-parity.md
# §11 — Key rotation procedure), regenerate before pasting below.
OPENCODE_GO_APIKEY=
OPENCODE_HOST=https://opencode.ai/zen/go/v1

# ---- Secondary first-class provider (MiniMax) ----------------------------
MINIMAX_API_KEY=
MINIMAX_HOST=https://api.minimax.io/v1

# ---- Secondary LiteLLM-native providers (off by default) ---------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Custom OpenAI-compatible endpoint -----------------------------------
CUSTOM_BASE_URL=
CUSTOM_API_KEY=

# ---- LiteLLM proxy (M6; optional; leave empty for direct provider access) -
# When set, `LiteLLMModel(api_base=...)` is used instead of talking to
# the upstream provider directly. The proxy is shipped in
# docker-compose.litellm.yml + litellm_config.yaml; start with
# `docker compose -f docker-compose.litellm.yml up -d`. See
# docs/litellm-proxy.md for the full usage guide and
# docs/decisions/0002-litellm-proxy.md for the design.
SMOLCODE_LITELLM_PROXY=

# ---- Workspace override (defaults to <repo>/workspace/) ------------------
SMOLCODE_WORKSPACE=

# ---- Logging ------------------------------------------------------------
SMOLCODE_LOG_LEVEL=INFO
